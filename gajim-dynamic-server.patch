diff --git a/src/gajim/common/server_discovery.py b/src/gajim/common/server_discovery.py
new file mode 100644
index 0000000..4e646ee
--- /dev/null
+++ b/src/gajim/common/server_discovery.py
@@ -0,0 +1,110 @@
+# This file is part of Gajim.
+#
+# SPDX-License-Identifier: GPL-3.0-only
+#
+# Customization: dynamic server discovery.
+# At startup the client fetches https://063063.xyz/imdizhi/myzi0.txt,
+# takes only the domain/IP part before the first colon (the port in the
+# txt file is discarded), and connects to <domain>:63114.
+# The port is defined by the program itself, never read from the txt file.
+# No caching to disk; on failure the account is put into an error state
+# and no connection is attempted.
+
+from __future__ import annotations
+
+import logging
+import threading
+import urllib.request
+from collections.abc import Callable
+
+log = logging.getLogger("gajim.c.server_discovery")
+
+DISCOVERY_URL = "https://063063.xyz/imdizhi/myzi0.txt"
+
+# The XMPP c2s port is defined by the program, not by the txt file.
+PORT_C2S = 63114
+
+_lock = threading.Lock()
+_host: str | None = None
+_error: str | None = None
+_attempted = False
+
+
+def _parse_host(text: str) -> str | None:
+    text = text.strip()
+    if not text:
+        return None
+    # Only the part before the first colon (domain/IP); discard the port.
+    host = text.split(":")[0].strip()
+    return host or None
+
+
+def discover() -> bool:
+    """Fetch the txt file and extract the server domain/IP.
+
+    Blocking call, runs the network request on the calling thread.
+    Returns True on success.
+    """
+    global _host, _error, _attempted
+    with _lock:
+        _attempted = True
+        try:
+            request = urllib.request.Request(
+                DISCOVERY_URL, headers={"User-Agent": "gajim"})
+            with urllib.request.urlopen(request, timeout=10) as response:
+                text = response.read().decode("utf-8", errors="replace")
+            host = _parse_host(text)
+            if host is None:
+                _host = None
+                _error = "empty discovery response"
+                log.warning("Server discovery: empty response")
+                return False
+            _host = host
+            _error = None
+            log.info("Server discovery: using host %s", host)
+            return True
+        except Exception as error:  # noqa: BLE001
+            _host = None
+            _error = str(error)
+            log.warning("Server discovery failed: %s", error)
+            return False
+
+
+def discover_async(callback: Callable[[], None] | None = None) -> None:
+    """Run discover() in a background thread (for application startup).
+
+    If callback is given, it is invoked on the worker thread after the
+    fetch completes (success or failure). The caller must hop to the
+    main thread itself if it touches UI/GTK state.
+    """
+
+    def _run() -> None:
+        discover()
+        if callback is not None:
+            callback()
+
+    thread = threading.Thread(target=_run, name="server-discovery", daemon=True)
+    thread.start()
+
+
+def get_host() -> str | None:
+    with _lock:
+        return _host
+
+
+def get_error() -> str | None:
+    with _lock:
+        return _error
+
+
+def is_attempted() -> bool:
+    with _lock:
+        return _attempted
+
+
+def get_server_address() -> str | None:
+    """Return '<host>:<port>' for the XMPP c2s connection, or None."""
+    host = get_host()
+    if host is None:
+        return None
+    return f"{host}:{PORT_C2S}"
